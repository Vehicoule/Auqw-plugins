{
  "name": "deezer catalog.entity — artist composite",
  "plugin": "deezer",
  "capability": "catalog.entity",
  "request": { "ref": { "provider": "deezer", "kind": "artist", "id": "1069" } },
  "upstreams": [
    {
      "url_contains": "api.deezer.com/artist/1069/top",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/artist-top.json"
    },
    {
      "url_contains": "api.deezer.com/artist/1069/albums",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/artist-albums.json"
    },
    {
      "url_contains": "api.deezer.com/artist/1069/related",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/artist-related.json"
    },
    {
      "url_contains": "api.deezer.com/artist/1069",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/artist.json"
    }
  ],
  "expect": {
    "result": "ok",
    "result_subset": {
      "items": [{ "title": "Glory Box" }],
      "related": [
        { "kind": "album", "group": "discography" },
        { "kind": "album", "group": "discography" },
        { "kind": "artist", "group": "related" }
      ]
    },
    "max_http_calls": 4
  }
}
