{
  "name": "deezer catalog.search — track rows + entity rails",
  "plugin": "deezer",
  "capability": "catalog.search",
  "request": { "query": "roads portishead", "limit": 10, "storefront": null },
  "upstreams": [
    {
      "url_contains": "api.deezer.com/search/artist",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/search-artist.json"
    },
    {
      "url_contains": "api.deezer.com/search/album",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/search-album.json"
    },
    {
      "url_contains": "api.deezer.com/search/playlist",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/search-playlist.json"
    },
    {
      "url_contains": "api.deezer.com/search",
      "status": 200,
      "body_file": "../../plugins/deezer/fixtures/search.json"
    }
  ],
  "expect": {
    "result": "ok",
    "result_subset": {
      "items": [{ "title": "Roads" }],
      "entities": [{ "kind": "artist", "title": "Portishead" }]
    },
    "max_http_calls": 4
  }
}
