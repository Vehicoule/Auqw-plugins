{
  "name": "deezer catalog.entity — playlist page",
  "plugin": "deezer",
  "capability": "catalog.entity",
  "request": { "ref": { "provider": "deezer", "kind": "playlist", "id": "908622995" } },
  "upstreams": [
    {
      "url_contains": "api.deezer.com/playlist/908622995",
