[package]
name = "auqw-guest-sdk"
version = "0.3.0"
edition = "2021"
license = "GPL-3.0-only"
description = "Guest-side SDK over the Auqw plugin step ABI"

# Guests need `unsafe` for the ABI pointer handoff; the workspace forbids
# unsafe_code, so this crate declares its own lints instead of inheriting.
[lints.clippy]
unwrap_used = "deny"
expect_used = "deny"

[dependencies]
serde_json = "1.0.149"
base64 = "0.22.1"
